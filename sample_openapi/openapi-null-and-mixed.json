{
  "openapi": "3.0.3",
  "info": {
    "title": "OpenAPI null and mixed responses",
    "version": "1.0.0"
  },
  "paths": {
    "/mixed": {
      "post": {
        "operationId": "mixedResponse",
        "responses": {
          "200": {
            "description": "A JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "202": {
            "description": "Accepted without a response body"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "required": ["nullable_value"],
        "properties": {
          "nullable_value": {
            "oneOf": [
              { "type": "string" },
              { "type": "null" }
            ]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" }
        }
      }
    }
  }
}
